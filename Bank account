#include <iostream>
#include <string>
using namespace std;

class BankAccount {
    string name;
    int accountNo;
    string type;
    double balance;

public:
    // Constructor
    BankAccount(string n, int acc, string t, double b) {
        name = n;
        accountNo = acc;
        type = t;
        balance = b;
    }

    void deposit(int acc, string n, double amount) {
        if (acc == accountNo && n == name) {
            balance += amount;
            cout << "Amount deposited successfully.\n";
        }
        else {
            cout << "Invalid account number or name.\n";
        }
    }

    void withdraw(double amount) {
        if (amount <= balance) {
            balance -= amount;
            cout << "Amount withdrawn successfully.\n";
        }
        else {
            cout << "Insufficient balance.\n";
        }
    }

    void display() {
        cout << "\nName: " << name << endl;
        cout << "Balance: Rs. " << balance << endl;
    }

    // Destructor
    ~BankAccount() {
        cout << "BankAccount object destroyed.\n";
    }
};

int main() {
    BankAccount b("Rahul", 12345, "Savings", 10000);

    b.deposit(12345, "Rahul", 5000);
    b.withdraw(2000);
    b.display();

    return 0;
}
